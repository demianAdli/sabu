{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/jsonschema/jug_gis_cities/standardized_output_response.schema.json",
  "title": "JUG GIS Cities Standardized Run Response",
  "description": "API/application response metadata for standardize mode. The standardized output file itself follows standardized_building_geojson.schema.json.",
  "type": "object",
  "required": [
    "component_name",
    "mode",
    "fsa",
    "workflow_output_path",
    "standardized_output_path",
    "cleaned_output_paths",
    "standardized_artifact_id",
    "standardized_download_url"
  ],
  "additionalProperties": false,
  "properties": {
    "component_name": {
      "type": "string",
      "examples": [
        "saint_malachie_gisoo"
      ]
    },
    "mode": {
      "type": "string",
      "const": "standardize"
    },
    "fsa": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][0-9][A-Z]$",
      "examples": [
        null,
        "H3H"
      ]
    },
    "workflow_output_path": {
      "type": "string",
      "examples": [
        "/data/output/saint_malachie_gisoo_with_fsa/saint_malachie_gisoo_with_fsa.shp"
      ]
    },
    "standardized_output_path": {
      "type": "string",
      "examples": [
        "/data/output/standardized.geojson"
      ]
    },
    "cleaned_output_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "examples": [
        []
      ]
    },
    "standardized_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Immutable registered standardized GeoJSON ID; null for failed, independent, or legacy batch results."
    },
    "standardized_download_url": {
      "type": "string",
      "format": "uri",
      "description": "Absolute HTTP download URL constructed by the API from the artifact ID."
    }
  }
}
