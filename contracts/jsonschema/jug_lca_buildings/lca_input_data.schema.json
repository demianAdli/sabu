{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/jsonschema/jug_lca_buildings/lca_input_data.schema.json",
  "title": "JUG LCA Buildings Input GeoJSON",
  "description": "GeoJSON input shared by both emissions endpoints and direct application calls. Unknown fields at all four object levels are accepted and excluded without modifying the source. Any invalid feature rejects the entire batch before cache lookup. Declared numeric types describe normalized values; Marshmallow also accepts numeric strings and coerces numeric values. No additional geometry type, coordinate length, or domain value checks are applied by input validation.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "properties": {
          "$ref": "#/$defs/buildingProperties"
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "description": "Three nested lists of numbers, typically Polygon coordinates structured as [ring][point][lon, lat].",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "buildingProperties": {
      "type": "object",
      "required": [
        "name",
        "address",
        "function",
        "height",
        "year_of_construction"
      ],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "function": { "type": "string" },
        "height": { "type": "number" },
        "year_of_construction": { "type": "integer" }
      }
    }
  }
}
