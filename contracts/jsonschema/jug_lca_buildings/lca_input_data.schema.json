{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/jsonschema/jug_lca_buildings/lca_input_data.schema.json",
  "title": "JUG LCA Buildings Input GeoJSON",
  "description": "Polygon/MultiPolygon GeoJSON input shared by both emissions endpoints and direct application calls. Mixed collections are accepted. Unknown fields at all four object levels are accepted and excluded without modifying the source. Any invalid feature rejects the entire batch before cache lookup. Declared numeric types describe normalized values; Marshmallow also accepts numeric strings and coerces numeric values. No additional ring-length, closure, topology, or domain value checks are applied. Coordinates must already be WGS84 longitude/latitude; no CRS conversion is performed.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "properties": {
          "$ref": "#/$defs/buildingProperties"
        }
      }
    },
    "geometry": {
      "description": "Either ring winding is accepted. The reader orients a working copy with counterclockwise exterior rings and clockwise holes, identified by ring position. Coordinate values, polygon parts, holes, and source inputs are preserved. No ring-length, closure, or topology repair is performed.",
      "oneOf": [
        { "$ref": "#/$defs/polygonGeometry" },
        { "$ref": "#/$defs/multiPolygonGeometry" }
      ]
    },
    "polygonGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "Polygon"
        },
        "coordinates": {
          "$ref": "#/$defs/polygonCoordinates"
        }
      }
    },
    "multiPolygonGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "description": "Polygon parts, each retaining its exterior ring and interior holes.",
          "items": { "$ref": "#/$defs/polygonCoordinates" }
        }
      }
    },
    "polygonCoordinates": {
      "type": "array",
      "description": "Three nested lists of numbers: [ring][point][number].",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "buildingProperties": {
      "type": "object",
      "required": [
        "name",
        "address",
        "function",
        "height",
        "year_of_construction"
      ],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "function": { "type": "string" },
        "height": { "type": "number" },
        "year_of_construction": { "type": "integer" }
      }
    }
  }
}
